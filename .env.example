# === Nova Casino — configuración ===
# Token del bot (Discord Developer Portal > tu app > Bot > Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# Application ID (Developer Portal > General Information > Application ID)
CLIENT_ID=pega_aqui_el_application_id

# (Opcional) ID de tu servidor de pruebas para registrar comandos al instante.
# Si lo dejas vacío, los comandos se registran globalmente (puede tardar ~1h).
GUILD_ID=

# (Opcional) Clave de la Odds API para las apuestas deportivas (/mercados, /apostar).
# Si la dejas vacía, el sistema de apuestas deportivas queda desactivado.
ODDS_API_KEY=

# (Opcional) Ruta de la base de datos. Por defecto data/casino.db. Útil para
# ponerla en un disco/volumen persistente aparte.
# CASINO_DB_PATH=

# (Opcional) PORT lo define automáticamente la plataforma (p. ej. Render "Web
# Service"). Si está presente, el bot abre un pequeño servidor de salud en ese
# puerto para que el deploy se considere sano. En local no hace falta ponerlo.
# PORT=
